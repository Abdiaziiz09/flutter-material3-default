# Normalise line endings so the repository behaves the same on every OS.
* text=auto eol=lf

# Windows scripts must keep CRLF line endings.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
