root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.dart]
# `dart format` uses an 80 column page width by default.
max_line_length = 80

[*.md]
# Trailing spaces are meaningful in Markdown line breaks.
trim_trailing_whitespace = false

[*.ps1]
end_of_line = crlf
